db/
logs/
*.log

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Project-specific ---
# Keep data/ source files (glossary JSON, corpus text) but ignore raw uploads
data/raw/*
!data/raw/.gitkeep
# External data processing scripts + large generated datasets (not source)
data/external/

# Keep the egg-info out (generated by pip install -e)
iraqi_legal_translation_agent.egg-info/
