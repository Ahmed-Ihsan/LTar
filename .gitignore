*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
sdist/
wheels/
*.whl
pip-wheel-metadata/
share/python-wheels/

# --- Virtual environments ---
.venv/
.venv310/
venv/
env/
ENV/

# --- AI agents / local tooling ---
.dev/
.devin/
.agents/

# --- OpenSpec (local spec-driven development, not part of the codebase) ---
openspec/

